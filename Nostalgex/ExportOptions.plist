<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Manual signing on purpose.

  Automatic ("cloud") signing fails from the CLI with "Cloud signing permission
  error": the App Store Connect API key cannot create signing assets, so
  xcodebuild falls back to a stale cached Xcode-managed profile that predates
  the Top Shelf extension and the App Groups capability.

  The two profiles below were created through the API and are installed in
  ~/Library/MobileDevice/Provisioning Profiles. Both, and the Apple Distribution
  certificate, expire 2027-09-05. Regenerate them (and re-download) if a target
  or capability is added, or if signing starts failing after that date.
-->
<plist version="1.0">
<dict>
  <key>method</key><string>app-store-connect</string>
  <key>teamID</key><string>KK5V95295A</string>
  <key>uploadSymbols</key><true/>
  <key>signingStyle</key><string>manual</string>
  <key>signingCertificate</key><string>Apple Distribution</string>
  <key>provisioningProfiles</key>
  <dict>
    <key>com.muellhaus.nostalgex</key><string>Nostalgex tvOS App Store</string>
    <key>com.muellhaus.nostalgex.TopShelf</key><string>Nostalgex TopShelf tvOS App Store</string>
  </dict>
</dict>
</plist>
